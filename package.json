{
  "name": "cassette",
  "productName": "Cassette",
  "version": "0.4.0",
  "description": "Apple Music for elementary OS. Based on Sidra by Martin Wimpress.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "author": "melvincouwez-alt <301110918+melvincouwez-alt@users.noreply.github.com>",
  "homepage": "https://github.com/melvincouwez-alt/cassette",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/melvincouwez-alt/cassette.git"
  },
  "bugs": "https://github.com/melvincouwez-alt/cassette/issues",
  "license": "BlueOak-1.0.0",
  "type": "commonjs",
  "devDependencies": {
    "electron": "github:castlabs/electron-releases#v44.1.0+wvcus",
    "electron-builder": "^26.16.1",
    "typescript": "^7.x",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@holusion/dbus-next": "^0.11.2",
    "electron-conf": "^1.3.0",
    "electron-log": "^5.x"
  },
  "overrides": {
    "brace-expansion": ">=5.0.6",
    "undici": "7.29.0"
  },
  "build": {
    "appId": "io.github.melvincouwez.Cassette",
    "copyright": "Copyright (c) Martin Wimpress, melvincouwez-alt",
    "artifactName": "${name}_${version}_${arch}.${ext}",
    "electronLanguages": [
      "fr",
      "en-US"
    ],
    "asar": true,
    "asarUnpack": [
      "assets/icons/**",
      "assets/locales/about.json",
      "assets/locales/loading.json",
      "assets/locales/tray.json",
      "assets/musicKitHook.js",
      "assets/navigationBar.js",
      "assets/settings.html",
      "assets/settings.css",
      "assets/settings.js",
      "assets/about.html",
      "assets/authFrameFix.js",
      "assets/authStyleFix.css",
      "assets/cassette-logo.png",
      "assets/splash.html",
      "assets/styleFix.css",
      "assets/windowChrome.css",
      "assets/headerbar.html",
      "assets/headerbar.css",
      "assets/headerbar.js",
      "assets/panel.html",
      "assets/panel.css",
      "assets/panel.js"
    ],
    "icon": "build/icon.png",
    "files": [
      "dist/**/*",
      "assets/**/*",
      "!assets/source/**"
    ],
    "directories": {
      "output": "release"
    },
    "electronDownload": {
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/"
    },
    "linux": {
      "icon": "build/icons",
      "target": [
        "deb"
      ],
      "category": "Audio",
      "executableName": "cassette",
      "desktop": {
        "entry": {
          "Actions": "PlayPause;Next;Previous;Stop;",
          "MimeType": "x-scheme-handler/itms;",
          "Name": "Cassette",
          "GenericName": "Apple Music",
          "Comment": "Listen to Apple Music",
          "Keywords": "Apple;Music;iTunes;Musique;Cassette;Boomerang;",
          "StartupWMClass": "io.github.melvincouwez.Cassette",
          "Comment[fr]": "Écouter Apple Music",
          "Icon": "io.github.melvincouwez.Cassette",
          "X-GNOME-UsesNotifications": "true"
        },
        "desktopActions": {
          "PlayPause": {
            "Name": "Play-Pause",
            "Exec": "dbus-send --print-reply --dest=org.mpris.MediaPlayer2.cassette /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player.PlayPause",
            "Name[fr]": "Lecture/Pause"
          },
          "Next": {
            "Name": "Next",
            "Exec": "dbus-send --print-reply --dest=org.mpris.MediaPlayer2.cassette /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player.Next",
            "Name[fr]": "Suivant"
          },
          "Previous": {
            "Name": "Previous",
            "Exec": "dbus-send --print-reply --dest=org.mpris.MediaPlayer2.cassette /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player.Previous",
            "Name[fr]": "Précédent"
          },
          "Stop": {
            "Name": "Stop",
            "Exec": "dbus-send --print-reply --dest=org.mpris.MediaPlayer2.cassette /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player.Stop",
            "Name[fr]": "Arrêter"
          }
        }
      },
      "syncDesktopName": true,
      "synopsis": "Apple Music, à la façon d'elementary"
    },
    "protocols": [
      {
        "name": "Apple Music URL",
        "schemes": [
          "itms"
        ]
      }
    ],
    "deb": {
      "maintainer": "melvincouwez-alt <301110918+melvincouwez-alt@users.noreply.github.com>",
      "priority": "optional",
      "depends": [
        "libgtk-3-0t64 | libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0t64 | libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ],
      "fpm": [
        "--replaces=aria",
        "--conflicts=aria",
        "--provides=aria",
        "LICENSE=/usr/share/doc/cassette/LICENSE",
        "packaging/copyright=/usr/share/doc/cassette/copyright",
        "data/io.github.melvincouwez.Cassette.metainfo.xml=/usr/share/metainfo/io.github.melvincouwez.Cassette.metainfo.xml",
        "data/io.github.melvincouwez.Cassette.svg=/usr/share/icons/hicolor/scalable/apps/io.github.melvincouwez.Cassette.svg",
        "data/icons/16.svg=/usr/share/icons/hicolor/16x16/apps/io.github.melvincouwez.Cassette.svg",
        "data/icons/16.svg=/usr/share/icons/hicolor/16x16@2/apps/io.github.melvincouwez.Cassette.svg",
        "data/icons/24.svg=/usr/share/icons/hicolor/24x24/apps/io.github.melvincouwez.Cassette.svg",
        "data/icons/24.svg=/usr/share/icons/hicolor/24x24@2/apps/io.github.melvincouwez.Cassette.svg",
        "data/icons/32.svg=/usr/share/icons/hicolor/32x32/apps/io.github.melvincouwez.Cassette.svg",
        "data/icons/32.svg=/usr/share/icons/hicolor/32x32@2/apps/io.github.melvincouwez.Cassette.svg",
        "data/icons/48.svg=/usr/share/icons/hicolor/48x48/apps/io.github.melvincouwez.Cassette.svg",
        "data/icons/48.svg=/usr/share/icons/hicolor/48x48@2/apps/io.github.melvincouwez.Cassette.svg"
      ]
    }
  },
  "desktopName": "io.github.melvincouwez.Cassette.desktop"
}
